{
  "name": "spectravert2",
  "productName": "spectravert2",
  "version": "2.0.0",
  "description": "Cross-platform video editing and conversion utilities",
  "main": ".vite/build/main.js",
  "scripts": {
    "tailwind-dev": "tailwindcss -i ./src/source.css -o ./src/index.css --watch",
    "tailwind-build": "tailwindcss -i ./src/source.css -o ./src/index.css",
    "start": "concurrently \"npm run tailwind-dev\" \"electron-forge start\"",
    "package": "pnpm run tailwind-build && electron-forge package",
    "make": "pnpm run tailwind-build && electron-forge make",
    "publish": "pnpm run tailwind-build && electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "build:mac": "electron-builder build --mac"
  },
  "keywords": [],
  "author": {
    "name": "Jay Simons",
    "email": "jay@designly.biz",
    "url": "https://1337707.xyz"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-deb": "^7.8.0",
    "@electron-forge/maker-rpm": "^7.8.0",
    "@electron-forge/maker-squirrel": "^7.8.0",
    "@electron-forge/maker-zip": "^7.8.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.0",
    "@electron-forge/plugin-fuses": "^7.8.0",
    "@electron-forge/plugin-vite": "^7.8.0",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/cli": "^4.1.3",
    "@tailwindcss/postcss": "^4.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "35.1.5",
    "electron-builder": "^26.0.12",
    "eslint": "^8.0.1",
    "eslint-plugin-import": "^2.25.0",
    "tailwindcss": "^4.1.3",
    "tailwindcss-motion": "^1.1.0",
    "ts-node": "^10.0.0",
    "typescript": "~4.5.4",
    "vite": "^5.0.12"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.0.2",
    "@types/ffprobe": "^1.1.8",
    "@types/react-beautiful-dnd": "^13.1.8",
    "electron-log": "^5.3.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^10.0.1",
    "ffprobe": "^1.1.2",
    "framer-motion": "^12.7.3",
    "react": "^19.1.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-toastify": "^11.0.5",
    "tailwind-merge": "^3.2.0"
  }
}